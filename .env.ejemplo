# Copiar a .env y cambiar las claves (sin comillas simples). Lo leen docker compose y el CLI `memoria`.
MARIADB_ROOT_PASSWORD=cambiar-root
MARIADB_DATABASE=memoria
MARIADB_USER=memoria
MARIADB_PASSWORD=cambiar-app
MEMORIA_AGENTE_PASSWORD=cambiar-agente
MEMORIA_LECTOR_PASSWORD=cambiar-lector
MEMORIA_PUERTO=3307

# CLI / librería
MEMORIA_DB_HOST=127.0.0.1
MEMORIA_DB_PORT=3307
MEMORIA_DB_NAME=memoria
MEMORIA_DB_USER=memoria
MEMORIA_DB_PASSWORD=cambiar-app
# motivos de SessionEnd que guardan la conversación (clear, logout, prompt_input_exit, other)
MEMORIA_HOOK_MOTIVOS=clear
# MEMORIA_CON_MENSAJES=1   guardar también los mensajes previos al compact
